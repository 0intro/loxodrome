					<aixm:part>
						<aixm:VerticalStructurePart gml:id="p-a-4">
							<aixm:verticalExtent uom="M">50</aixm:verticalExtent>
							<aixm:type>ANTENNA</aixm:type>
							<aixm:horizontalProjection_location>
								<aixm:ElevatedPoint srsName="urn:ogc:def:crs:EPSG::4326" gml:id="pt-a-4">
									<gml:pos>40.80000 -3.80000</gml:pos>
									<aixm:elevation uom="M">720</aixm:elevation>
								</aixm:ElevatedPoint>
							</aixm:horizontalProjection_location>
						</aixm:VerticalStructurePart>
					</aixm:part>
				</aixm:VerticalStructureTimeSlice>
			</aixm:timeSlice>
		</aixm:VerticalStructure>
	</message:hasMember>

	<!-- VS5: SNAPSHOT interpretation; counted into SkippedNonBaseline,
	     not emitted. -->
