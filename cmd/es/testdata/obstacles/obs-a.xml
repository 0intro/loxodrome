<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic AIXM 5.1 obstacle fixture for cmd/es tests (not real data).
     Paired with obs-b.xml to exercise decodeInputs' sum-with-no-dedup
     merge and BuildObstacles' 30 m / height-less filter. -->
<message:AIXMBasicMessage
	xmlns:message="http://www.aixm.aero/schema/5.1/message"
	xmlns:gco="http://www.isotc211.org/2005/gco"
	xmlns:gml="http://www.opengis.net/gml/3.2"
	xmlns:aixm="http://www.aixm.aero/schema/5.1"
	xmlns:gmd="http://www.isotc211.org/2005/gmd"
	gml:id="M-ES-A">
	<aixm:messageMetadata>
		<gmd:MD_Metadata>
			<gmd:dateStamp>
				<gco:DateTime>2026-05-14T00:00:00Z</gco:DateTime>
			</gmd:dateStamp>
		</gmd:MD_Metadata>
	</aixm:messageMetadata>

	<!-- VS1: tall lit wind turbine; kept. Shares its identifier with a
	     row in obs-b.xml to prove the merge does not de-duplicate. -->
	<message:hasMember>
		<aixm:VerticalStructure gml:id="uuid.es-a-1">
			<gml:identifier codeSpace="urn:uuid:">ES-OBS-WT-001</gml:identifier>
			<aixm:timeSlice>
				<aixm:VerticalStructureTimeSlice gml:id="ts-a-1">
					<aixm:interpretation>BASELINE</aixm:interpretation>
					<aixm:name>Parque Eolico Norte 1</aixm:name>
					<aixm:type>WIND_TURBINE</aixm:type>
					<aixm:lighted>YES</aixm:lighted>
					<aixm:part>
						<aixm:VerticalStructurePart gml:id="p-a-1">
							<aixm:verticalExtent uom="M">120</aixm:verticalExtent>
							<aixm:type>WIND_TURBINE</aixm:type>
							<aixm:horizontalProjection_location>
								<aixm:ElevatedPoint srsName="urn:ogc:def:crs:EPSG::4326" gml:id="pt-a-1">
									<gml:pos>40.50000 -3.50000</gml:pos>
									<aixm:elevation uom="M">700</aixm:elevation>
								</aixm:ElevatedPoint>
							</aixm:horizontalProjection_location>
						</aixm:VerticalStructurePart>
					</aixm:part>
				</aixm:VerticalStructureTimeSlice>
			</aixm:timeSlice>
		</aixm:VerticalStructure>
	</message:hasMember>

	<!-- VS2: short building (20 m < 30 m floor); dropped as too short. -->
	<message:hasMember>
		<aixm:VerticalStructure gml:id="uuid.es-a-2">
			<gml:identifier codeSpace="urn:uuid:">ES-OBS-BLD-002</gml:identifier>
			<aixm:timeSlice>
				<aixm:VerticalStructureTimeSlice gml:id="ts-a-2">
					<aixm:interpretation>BASELINE</aixm:interpretation>
					<aixm:name>Edificio Bajo</aixm:name>
					<aixm:type>BUILDING</aixm:type>
					<aixm:lighted>NO</aixm:lighted>
					<aixm:part>
						<aixm:VerticalStructurePart gml:id="p-a-2">
							<aixm:verticalExtent uom="M">20</aixm:verticalExtent>
							<aixm:type>BUILDING</aixm:type>
							<aixm:horizontalProjection_location>
								<aixm:ElevatedPoint srsName="urn:ogc:def:crs:EPSG::4326" gml:id="pt-a-2">
									<gml:pos>40.60000 -3.60000</gml:pos>
									<aixm:elevation uom="M">650</aixm:elevation>
								</aixm:ElevatedPoint>
							</aixm:horizontalProjection_location>
						</aixm:VerticalStructurePart>
					</aixm:part>
				</aixm:VerticalStructureTimeSlice>
			</aixm:timeSlice>
		</aixm:VerticalStructure>
	</message:hasMember>

	<!-- VS3: mast with no verticalExtent (height-less); dropped as too short. -->
	<message:hasMember>
		<aixm:VerticalStructure gml:id="uuid.es-a-3">
			<gml:identifier codeSpace="urn:uuid:">ES-OBS-MST-003</gml:identifier>
			<aixm:timeSlice>
				<aixm:VerticalStructureTimeSlice gml:id="ts-a-3">
					<aixm:interpretation>BASELINE</aixm:interpretation>
					<aixm:name>Mastil Sin Altura</aixm:name>
