<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic AIXM 5.1 obstacle fixture; see obs-a.xml. Carries a later
     dateStamp than obs-a to confirm decodeInputs keeps the first file's
     effective date. -->
<message:AIXMBasicMessage
	xmlns:message="http://www.aixm.aero/schema/5.1/message"
	xmlns:gco="http://www.isotc211.org/2005/gco"
	xmlns:gml="http://www.opengis.net/gml/3.2"
	xmlns:aixm="http://www.aixm.aero/schema/5.1"
	xmlns:gmd="http://www.isotc211.org/2005/gmd"
	gml:id="M-ES-B">
	<aixm:messageMetadata>
		<gmd:MD_Metadata>
			<gmd:dateStamp>
				<gco:DateTime>2026-06-11T00:00:00Z</gco:DateTime>
			</gmd:dateStamp>
		</gmd:MD_Metadata>
	</aixm:messageMetadata>

	<!-- VS6: tall lit tower; kept. -->
	<message:hasMember>
		<aixm:VerticalStructure gml:id="uuid.es-b-6">
			<gml:identifier codeSpace="urn:uuid:">ES-OBS-TWR-006</gml:identifier>
			<aixm:timeSlice>
				<aixm:VerticalStructureTimeSlice gml:id="ts-b-6">
					<aixm:interpretation>BASELINE</aixm:interpretation>
					<aixm:name>Torre de Control</aixm:name>
					<aixm:type>TOWER</aixm:type>
					<aixm:lighted>YES</aixm:lighted>
					<aixm:part>
						<aixm:VerticalStructurePart gml:id="p-b-6">
							<aixm:verticalExtent uom="M">60</aixm:verticalExtent>
							<aixm:type>TOWER</aixm:type>
							<aixm:horizontalProjection_location>
								<aixm:ElevatedPoint srsName="urn:ogc:def:crs:EPSG::4326" gml:id="pt-b-6">
									<gml:pos>41.00000 -4.00000</gml:pos>
									<aixm:elevation uom="M">800</aixm:elevation>
								</aixm:ElevatedPoint>
							</aixm:horizontalProjection_location>
						</aixm:VerticalStructurePart>
					</aixm:part>
				</aixm:VerticalStructureTimeSlice>
			</aixm:timeSlice>
		</aixm:VerticalStructure>
	</message:hasMember>

	<!-- VS7: same identifier as obs-a VS1; both survive the merge,
