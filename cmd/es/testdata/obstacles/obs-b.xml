		<aixm:VerticalStructure gml:id="uuid.es-b-7">
			<gml:identifier codeSpace="urn:uuid:">ES-OBS-WT-001</gml:identifier>
			<aixm:timeSlice>
				<aixm:VerticalStructureTimeSlice gml:id="ts-b-7">
