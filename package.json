{
  "name": "loxodrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aeronautical information, flight preparation and navigation, on one chart-faithful map",
  "keywords": [
    "aviation",
    "vfr",
    "flight-planning",
    "notam",
    "aip"
  ],
  "author": "David du Colombier",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_ACCOUNT_LIVE=1 vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:api": "tsc -p account-api --noEmit && tsc -p account-api/test --noEmit",
    "test:api": "node --test \"account-api/test/*.test.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "lint:i18n": "node scripts/i18n-lint.js",
    "gen:brand": "node scripts/gen-brand.js",
    "gen:licenses": "node scripts/gen-licenses.js",
    "gen:privacy": "node scripts/gen-privacy.js",
    "verify": "npm run lint && npm run lint:i18n && npm run check && npm run check:api && npm run test && npm run test:api && vite build",
    "android:sync": "svelte-check --tsconfig ./tsconfig.json && vite build && cap sync android",
    "android:sync:debug": "svelte-check --tsconfig ./tsconfig.json && VITE_ACCOUNT_API_URL=http://localhost:8788 VITE_TURNSTILE_SITEKEY=none vite build && cap sync android",
    "android:apk": "npm run android:sync:debug && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run lint && npm run lint:i18n && npm run check && npm run test && npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.2.108",
    "pmtiles": "^4.4.1",
    "rbush": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/rbush": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.9.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
